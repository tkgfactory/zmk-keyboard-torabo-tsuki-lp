#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        basic {
            bindings = <
&none  &none      &none     &none     &none           &none                         &none      &none  &none      &none      &none         &none
&none  &kp Q      &kp W     &kp E     &kp R           &kp T                         &kp Y      &kp U  &kp I      &kp O      &kp P         &none
&none  &kp A      &kp S     &kp D     &kp F           &kp G  &kp SPACE  &kp SPACE   &kp H      &kp J  &kp K      &kp L      &kp BSPC      &none
&none  &kp Z      &kp X     &kp C     &kp V           &kp B  &to 4      &to 0       &kp N      &kp M  &mkp LCLK  &mkp RCLK  &kp ENTER     &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &kp LEFT_SHIFT  &mo 2  &mo 1      &kp LSHIFT  &kp SPACE  &none  &none      &mo 3      &bt BT_SEL 1  &none
            >;
        };

        functional {
            bindings = <
&none  &none       &none           &none     &none            &none                                     &none             &none              &none                 &none                  &none      &none
&none  &kp ESCAPE  &none           &kp UP    &none            &kp INSERT                                &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DEL    &none
&none  &kp GRAVE   &kp LEFT_ARROW  &kp DOWN  &kp RIGHT_ARROW  &kp K_SCROLL_UP    &none  &none           &none             &kp SEMICOLON      &kp COLON             &kp MINUS              &kp AT     &none
&none  &kp TAB     &none           &none     &msc MOVE_Y(0)   &kp K_SCROLL_DOWN  &mo 3  &kp SPACE       &kp EXCLAMATION   &kp QUESTION       &kp COMMA             &kp PERIOD             &kp SLASH  &none
&none  &kp CLCK    &none           &none     &kp LSHIFT       &mo 2              &mo 1  &kp LEFT_SHIFT  &kp SPACE         &none              &none                 &none                  &none      &none
            >;
        };

        numkeys {
            bindings = <
&none  &none      &none   &none   &none           &none                           &none         &none   &none   &none   &none       &none
&none  &kp F1     &kp F2  &kp F3  &kp F4          &kp F5                          &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp PLUS    &none
&none  &kp F6     &kp F7  &kp F8  &kp F9          &kp F10  &none  &none           &kp SLASH     &kp N4  &kp N5  &kp N6  &kp MINUS   &none
&none  &none      &none   &none   &none           &none    &mo 3  &kp SPACE       &kp N0        &kp N1  &kp N2  &kp N3  &kp PERIOD  &none
&none  &kp ENTER  &none   &none   &kp LEFT_SHIFT  &mo 2    &mo 1  &kp LEFT_SHIFT  &kp SPACE     &none   &none   &none   &kp EQUAL   &none
            >;
        };

        setting {
            bindings = <
&none  &none  &none  &none  &none   &none                   &none         &none           &none         &none         &none         &none
&none  &none  &none  &none  &none   &none                   &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
&none  &none  &none  &none  &none   &none   &none   &none   &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none         &none
&none  &none  &none  &none  &none   &none   &trans  &trans  &none         &none           &none         &none         &none         &none
&none  &none  &none  &none  &trans  &trans  &trans  &trans  &trans        &none           &none         &none         &none         &none
            >;
        };

        ipad {
            bindings = <
&none  &none      &none         &none         &none           &none                     &none      &none  &none      &none      &none      &none
&none  &kp Q      &kp W         &kp E         &kp R           &kp T                     &kp Y      &kp U  &kp I      &kp O      &kp P      &none
&none  &kp A      &kp S         &kp D         &kp F           &kp G  &none  &none       &kp H      &kp J  &kp K      &kp L      &kp BSPC   &none
&none  &kp Z      &kp X         &kp C         &kp V           &kp B  &to 4  &to 0       &kp N      &kp M  &mkp LCLK  &mkp RCLK  &kp ENTER  &none
&none  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &kp LEFT_SHIFT  &mo 2  &mo 1  &kp LSHIFT  &kp SPACE  &none  &none      &none      &none      &none
            >;
        };
    };
};
